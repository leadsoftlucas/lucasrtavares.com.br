---
import Base from '../layouts/Base.astro';
import { homePath, routes } from '../i18n';

// Pagina 404 em tom de banco de dados: mostra uma consulta RQL (o dialeto de consulta do RavenDB) que
// "nao encontrou documento", sugere a pagina mais parecida e lembra que, quando nao resolve, eu digo.
const pages = [
  { path: homePath.pt, label: 'Início' },
  { path: routes.story.pt, label: 'História' },
  { path: routes.proof.pt, label: 'Provas' },
  { path: routes.press.pt, label: 'Imprensa' },
  { path: homePath.en, label: 'Home (EN)' },
  { path: routes.story.en, label: 'Story (EN)' },
  { path: routes.proof.en, label: 'Proof (EN)' },
  { path: routes.press.en, label: 'Press (EN)' },
];
---
<Base lang="pt" title="404 · Documento não encontrado · Lucas Resende Tavares" description="Esta página não existe. Volte ao início." onHome={false} noindex>
  <section class="nf">
    <div class="bg-cosmic bg"></div>
    <div class="wrap inner">
      <p class="code" aria-hidden="true">404</p>

      <div data-lang="pt">
        <h1>Documento não encontrado</h1>
        <p class="lead">O índice rodou, a busca vetorial também, e nada. Esse endereço não existe (ou mudou de lugar).</p>
      </div>
      <div data-lang="en" hidden>
        <p class="title" role="heading" aria-level="1">Document not found</p>
        <p class="lead">The index ran, the vector search ran too, and nothing. This address does not exist (or has moved).</p>
      </div>

      <div class="console" role="img" aria-label="Consulta RQL sem resultados">
        <div class="bar"><span></span><span></span><span></span><em>Studio · Query</em></div>
        <pre><code><span class="k">from</span> Pages
<span class="k">where</span> Path = <span class="s" data-path>'/…'</span>
<span class="k">select</span> Title, Url</code></pre>
        <p class="res"><b>0 resultados</b> em <b>0 ms</b> · índice <i>Auto/Pages/ByPath</i> · <span class="ok">não obsoleto</span></p>
      </div>

      <div class="suggest" data-suggest hidden>
        <p class="sg" data-lang="pt">Será que você quis dizer:</p>
        <p class="sg" data-lang="en" hidden>Did you mean:</p>
        <a href="/" data-suggest-link class="btn btn-grad">/</a>
      </div>

      <p class="raven" data-lang="pt">O corvo saiu para buscar esse documento e <em>voltou de bico vazio</em>. Nenhum resultado foi inventado nesta consulta: quando não acho, eu digo.</p>
      <p class="raven" data-lang="en" hidden>The raven flew off to fetch that document and <em>came back empty-beaked</em>. No results were made up in this query: when I can't find something, I say so.</p>

      <div class="links">
        <a href="/" class="btn btn-grad" data-lang="pt">Voltar ao início</a>
        <a href="/en/" class="btn btn-grad" data-lang="en" hidden>Back home</a>
        <a href={routes.story.pt} class="btn btn-line-light" data-lang="pt">História</a>
        <a href={routes.story.en} class="btn btn-line-light" data-lang="en" hidden>Story</a>
        <a href={routes.proof.pt} class="btn btn-line-light" data-lang="pt">Provas</a>
        <a href={routes.proof.en} class="btn btn-line-light" data-lang="en" hidden>Proof</a>
      </div>
    </div>
  </section>
  <script is:inline type="application/json" id="known-pages" set:html={JSON.stringify(pages)} />
</Base>

<script>
  import '../scripts/not-found';
</script>

<style>
  /* a pagina e curta: o <main> vira coluna e o fundo escuro ocupa o espaco ate o rodape */
  :global(main) {
    display: flex;
    flex-direction: column;
  }
  .nf {
    position: relative;
    flex: 1 0 auto;
    background: var(--bg-dark);
    overflow: hidden;
  }
  .bg {
    background-position: 50% 30%;
    opacity: 0.9;
  }
  .inner {
    position: relative;
    padding-top: clamp(48px, 8vw, 96px);
    padding-bottom: clamp(56px, 8vw, 110px);
  }
  .code {
    margin: 0;
    font-size: clamp(80px, 16vw, 180px);
    line-height: 0.9;
    font-weight: 800;
    letter-spacing: -0.06em;
    background: linear-gradient(90deg, var(--cyan) 0%, #63ffa6 55%, var(--blue-link) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  h1,
  .title {
    margin: 10px 0 12px;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .lead {
    margin: 0 0 28px;
    max-width: 58ch;
    font-size: 17px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.82);
  }
  .console {
    max-width: 560px;
    margin: 0 0 24px;
    border-radius: 14px;
    background: rgba(6, 9, 15, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.14);
    overflow: hidden;
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.45);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.06);
  }
  .bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.28);
  }
  .bar em {
    margin-left: 10px;
    font-size: 11px;
    font-style: normal;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }
  pre {
    margin: 0;
    padding: 16px 18px 6px;
    overflow-x: auto;
  }
  code {
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 14px;
    line-height: 1.7;
    color: #e6edf7;
  }
  .k {
    color: #63ffa6;
  }
  .s {
    color: var(--cyan-soft);
  }
  .res {
    margin: 0;
    padding: 6px 18px 16px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.7);
  }
  .res b {
    color: #fff;
  }
  .res i {
    font-style: normal;
    color: var(--cyan-soft);
  }
  .ok {
    color: #63ffa6;
  }
  .suggest {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .sg {
    margin: 0;
    font-size: 15px;
    color: rgba(255, 255, 255, 0.85);
  }
  .raven {
    margin: 0 0 24px;
    max-width: 60ch;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.75);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  [hidden] {
    display: none !important;
  }
</style>
