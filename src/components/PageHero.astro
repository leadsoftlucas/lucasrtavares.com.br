---
import { renderInline } from '../lib/inline';

interface Props {
  overline?: string;
  title: string;
  lead?: string;
  /** Mostra o retrato do Lucas (so telas largas). */
  portrait?: boolean;
}
const { overline, title, lead, portrait = false } = Astro.props;
---
<section class="hero">
  <div class="bg-cosmic bg"></div>
  <div class:list={['wrap', 'inner', { withPortrait: portrait }]}>
    <div class="copy">
      {overline && <p class="overline">{overline}</p>}
      <h1>{title}</h1>
      {lead && <p class="lead" set:html={renderInline(lead)} />}
    </div>
    {portrait && (
      <div class="photo">
        <div class="glow"></div>
        <img
          src="/assets/lucas-tavares-620.png"
          srcset="/assets/lucas-tavares-620.png 620w, /assets/lucas-tavares.png 1238w"
          sizes="320px"
          width="619"
          height="840"
          alt="Lucas Resende Tavares"
          loading="lazy"
        />
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--bg-dark);
    overflow: hidden;
  }
  .bg {
    background-position: center;
    opacity: 0.9;
  }
  .hero::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--cyan) 0%, var(--blue-link) 50%, var(--purple) 100%);
  }
  .inner {
    position: relative;
    padding-top: clamp(48px, 7vw, 88px);
    padding-bottom: clamp(44px, 6vw, 80px);
  }
  .photo {
    display: none;
  }
  .overline {
    color: #63ffa6;
  }
  h1 {
    margin: 0 0 18px;
    max-width: 22ch;
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #fff;
    text-wrap: balance;
  }
  .lead {
    margin: 0;
    max-width: 62ch;
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.82);
    text-wrap: pretty;
  }
  .lead :global(em) {
    font-style: italic;
  }
  @media (min-width: 860px) {
    .withPortrait {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: 32px;
      align-items: end;
      padding-bottom: 0;
    }
    .withPortrait .copy {
      padding-bottom: clamp(44px, 6vw, 80px);
    }
    .photo {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: flex-end;
    }
    .glow {
      position: absolute;
      bottom: 0;
      width: 280px;
      aspect-ratio: 1;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(28, 200, 238, 0.4) 0%, rgba(123, 81, 255, 0.16) 45%, rgba(15, 20, 37, 0) 72%);
    }
    .photo img {
      position: relative;
      display: block;
      width: auto;
      max-width: 100%;
      height: 340px;
      object-fit: contain;
      object-position: bottom;
      filter: drop-shadow(0 20px 44px rgba(0, 0, 0, 0.55));
    }
  }
</style>
