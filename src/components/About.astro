---
import { dictionaries, type Lang } from '../i18n';
import { renderInline } from '../lib/inline';
import SpotifyEmbed from './SpotifyEmbed.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dictionaries[lang];
---
<section id="sobre">
  <div class="wrap inner">
    <div class="head">
      <p class="overline">{t.aboutOverline}</p>
      <h2>{t.aboutTitle}</h2>
      <div class="rule"></div>
    </div>
    <div class="cols">
      <div class="col">
        <p>{t.about1}</p>
        <p>{t.about2}</p>
      </div>
      <div class="col">
        <p>{t.about3}</p>
        <blockquote>
          <p class="quote">{t.aboutQuote}</p>
        </blockquote>
      </div>
    </div>
    <div class="mission">
      <h3>{t.missionOverline}</h3>
      <div class="mcols">
        <p>{t.mission1}</p>
        <p>{t.mission2}</p>
      </div>
    </div>
    <p class="outside" set:html={renderInline(t.outside)} />
    <SpotifyEmbed lang={lang} />
  </div>
</section>

<style>
  section {
    background: var(--band-cool);
    background-image: url('/assets/dot-grid.svg');
    background-size: 26px;
  }
  .inner {
    padding-top: clamp(56px, 8vw, 104px);
    padding-bottom: clamp(56px, 8vw, 104px);
  }
  .head {
    max-width: 46ch;
  }
  .overline {
    color: var(--blue-link);
  }
  h2 {
    margin: 0 0 18px;
    font-size: clamp(28px, 3.8vw, 44px);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-wrap: balance;
  }
  .rule {
    width: 72px;
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg, #10d9e8 0%, #1458f5 100%);
  }
  .cols {
    margin-top: clamp(30px, 4vw, 46px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: clamp(24px, 3.4vw, 44px);
    align-items: start;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .col:nth-child(2) {
    gap: 18px;
  }
  .col > p,
  .mcols > p,
  .outside,
  .quote {
    margin: 0;
    font-size: 16px;
    font-weight: 450;
    line-height: 1.72;
    color: var(--ink-soft);
    text-wrap: pretty;
  }
  blockquote {
    margin: 0;
    padding: 24px 26px;
    border-radius: var(--radius-md);
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: 0 4px 12px rgba(15, 20, 37, 0.05);
  }
  .quote {
    line-height: 1.6;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .mission {
    margin-top: clamp(30px, 4vw, 48px);
    padding: clamp(26px, 4vw, 40px);
    border-radius: 20px;
    background: linear-gradient(135deg, rgba(56, 142, 233, 0.1) 0%, rgba(123, 81, 255, 0.08) 100%);
    border: 1px solid rgba(56, 142, 233, 0.28);
  }
  .outside {
    margin-top: clamp(30px, 4vw, 48px);
    max-width: 78ch;
  }
  h3 {
    margin: 0 0 18px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--blue);
  }
  .mcols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: clamp(20px, 3vw, 40px);
  }
</style>
