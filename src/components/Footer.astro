---
import { dictionaries, routes, type Lang } from '../i18n';
import { config } from '../config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dictionaries[lang];
---
<footer>
  <div class="inner">
    <div class="brand">
      <img src="/assets/lambda.svg" alt={t.brandAlt} height="30" />
      <div>
        <p class="domain">lucasrtavares.com.br</p>
        <p class="note">{t.footerNote}</p>
      </div>
    </div>
    <nav class="pages" aria-label="Pages">
      <a href={routes.story[lang]}>{t.footerLinks.story}</a>
      <span aria-hidden="true">·</span>
      <a href={routes.proof[lang]}>{t.footerLinks.proof}</a>
      <span aria-hidden="true">·</span>
      <a href={routes.press[lang]}>{t.footerLinks.press}</a>
    </nav>
    <p class="legal">
      <a href="https://leadsoft.inf.br" target="_blank" rel="noopener" title="LeadSoft Soluções Web">LeadSoft</a>, uma marca Lambda Tech · LUCAS R TAVARES TECH LTDA · CNPJ 31.706.323/0001-29 · Curitiba/PR — Brasil
    </p>
    <div class="links">
      <a href="https://ravendb.net" target="_blank" rel="noopener" class="pill">
        <img src="/assets/ravendb-r-mark.png" alt="" height="16" />
        <span>ravendb.net</span>
      </a>
      <a href="https://www.linkedin.com/company/ravendb/" target="_blank" rel="noopener" class="pill ghost">RavenDB · LinkedIn</a>
      <a href="https://github.com/leadsoftlucas" target="_blank" rel="noopener" title="GitHub" class="icon"><img src="/assets/github.png" alt="GitHub" width="30" height="30" /></a>
      <a href="https://www.youtube.com/@LucasResendeTavares" target="_blank" rel="noopener" title="YouTube" class="icon"><img src="/assets/youtube.png" alt="YouTube" width="30" height="30" /></a>
      <a href="https://www.linkedin.com/in/lucasrtavares/" target="_blank" rel="noopener" title="LinkedIn" class="icon"><img src="/assets/linkedin.png" alt="LinkedIn" width="30" height="30" /></a>
      <a href={`mailto:${config.emailPersonal}`} class="mail">{config.emailPersonal}</a>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--bg-darker);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .inner {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 40px var(--gutter);
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: center;
    justify-content: space-between;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .brand img {
    height: 30px;
    width: auto;
    display: block;
  }
  .domain {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    color: #fff;
  }
  .note {
    margin: 2px 0 0;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.45);
  }
  .pages {
    flex: 1 1 100%;
    order: 2;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    font-size: 12px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.45);
  }
  .pages a {
    color: rgba(255, 255, 255, 0.78);
  }
  .pages a:hover {
    color: var(--cyan);
  }
  .legal {
    margin: 0;
    flex: 1 1 100%;
    order: 3;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 11px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.62);
    text-wrap: pretty;
  }
  .legal a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .legal a:hover {
    color: var(--cyan);
  }
  .links {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding: 0 14px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(28, 200, 238, 0.4);
    color: var(--cyan-soft);
    font-size: 12px;
    font-weight: 700;
  }
  .pill img {
    height: 16px;
    width: auto;
    display: block;
  }
  .pill:hover {
    background: rgba(28, 200, 238, 0.14);
    color: #fff;
  }
  .pill.ghost {
    border-color: rgba(255, 255, 255, 0.22);
    color: rgba(255, 255, 255, 0.72);
  }
  .pill.ghost:hover {
    background: none;
    border-color: var(--cyan);
    color: var(--cyan);
  }
  .icon {
    display: block;
  }
  .icon:hover {
    opacity: 0.7;
  }
  .icon img {
    width: 30px;
    height: 30px;
    display: block;
    border-radius: var(--radius-sm);
  }
  .mail {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.62);
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }
  .mail:hover {
    color: var(--cyan);
  }
</style>
