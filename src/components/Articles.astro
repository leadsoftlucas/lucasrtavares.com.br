---
import { dictionaries, type Lang } from '../i18n';
import { articles, articlesIndexUrl } from '../data/articles';

interface Props {
  lang: Lang;
}
const t = dictionaries[Astro.props.lang];
---
<section id="artigos">
  <div class="wrap inner">
    <div class="head">
      <div class="intro">
        <h2 class="h2">{t.articlesTitle}</h2>
        <p class="lead">{t.articlesLead}</p>
      </div>
      <div class="avatar">
        <div class="bg-cosmic bg"></div>
        <img src="/assets/avatar-bust.png" alt={t.avatarAlt} loading="lazy" />
      </div>
    </div>
    <div class="grid">
      {t.articles.map((a, i) => (
        <div class="card">
          <div class="cover">
            <img src={`/${articles[i].cover}`} alt="" loading="lazy" />
          </div>
          <div class="body">
            <span class="tag">{a.tag}</span>
            <h3><a href={articles[i].url} target="_blank" rel="noopener">{a.title}</a></h3>
            <p class="d">{a.d}</p>
            <a href={articles[i].url} target="_blank" rel="noopener" class="read">{t.articleRead}</a>
          </div>
        </div>
      ))}
    </div>
    <div class="all">
      <a href={articlesIndexUrl} target="_blank" rel="noopener" class="btn all-btn" style="--btn-h: 48px; --btn-px: 24px; --btn-fs: 14px;">{t.articlesCta}</a>
    </div>
  </div>
</section>

<style>
  section {
    background: var(--bg-light);
    background-image: url('/assets/dot-grid.svg');
    background-size: 26px;
  }
  .inner {
    padding-top: clamp(56px, 8vw, 104px);
    padding-bottom: clamp(56px, 8vw, 104px);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(20px, 4vw, 48px);
    align-items: flex-end;
    margin-bottom: 40px;
  }
  .intro {
    flex: 1 1 380px;
    min-width: 0;
  }
  .h2 {
    margin: 0 0 12px;
    color: var(--ink);
  }
  .lead {
    color: var(--ink-soft);
  }
  .avatar {
    flex: 0 0 auto;
    position: relative;
    width: clamp(190px, 24vw, 250px);
    height: clamp(190px, 24vw, 250px);
    border-radius: 24px;
    overflow: hidden;
    background: linear-gradient(160deg, var(--bg-dark) 0%, #071f72 60%, var(--blue) 100%);
    box-shadow: 0 18px 40px rgba(15, 20, 37, 0.16);
  }
  .avatar .bg {
    background-position: 40% 60%;
    opacity: 0.8;
  }
  .avatar img {
    position: absolute;
    left: 52%;
    bottom: 0;
    transform: translateX(-50%);
    height: 96%;
    width: auto;
    display: block;
    filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.45));
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
  .card {
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: 0 4px 12px rgba(15, 20, 37, 0.05);
    height: 100%;
  }
  .card:hover {
    border-color: var(--blue-link);
    box-shadow: 0 18px 40px rgba(15, 20, 37, 0.12);
  }
  .cover {
    position: relative;
    background: var(--bg-dark);
  }
  .cover img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 26px;
    flex: 1;
  }
  .tag {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--purple);
  }
  h3 {
    margin: 0;
    font-size: 18px;
    line-height: 1.35;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-wrap: pretty;
  }
  h3 a {
    color: inherit;
  }
  h3 a:hover {
    color: var(--blue);
  }
  .d {
    margin: 0;
    font-size: 14px;
    font-weight: 450;
    line-height: 1.6;
    color: var(--ink-soft);
    text-wrap: pretty;
    flex: 1;
  }
  .read {
    align-self: flex-start;
    font-size: 13px;
    font-weight: 700;
    color: var(--blue);
    border-bottom: 1px solid rgba(12, 47, 165, 0.3);
  }
  .read:hover {
    color: var(--cyan);
    border-color: var(--cyan);
  }
  .all {
    margin-top: 28px;
    display: flex;
    justify-content: flex-start;
  }
  .all-btn,
  .all-btn:hover {
    border: 1px solid var(--blue-link);
  }
  .all-btn {
    color: var(--blue);
    background: #fff;
  }
  .all-btn:hover {
    background: var(--blue-link);
    color: #fff;
  }
</style>
