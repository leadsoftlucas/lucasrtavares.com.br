---
import { dictionaries, type Lang } from '../i18n';
import { config, whatsappLink } from '../config';

interface Props {
  lang: Lang;
  title: string;
  /** Indices dos cartoes de lead em i18n (0 Avaliacao, 3 POC, 5 Convite, 7 Arquitetura). */
  cards?: number[];
  /** Mostra o e-mail pessoal (imprensa) em vez do e-mail RavenDB. */
  press?: boolean;
  mailNote?: string;
}
const { lang, title, cards = [0, 3, 7], press = false, mailNote } = Astro.props;
const t = dictionaries[lang];
const items = cards.map((i) => ({ ...t.leads[i], href: whatsappLink(t.leads[i].msg) }));
const mail = press ? config.emailPersonal : config.emailRavendb;
---
<section class="cta">
  <div class="bg-cosmic bg"></div>
  <div class="wrap inner">
    <h2>{title}</h2>
    <div class="cards">
      {items.map((l) => (
        <a href={l.href} target="_blank" rel="noopener" data-lead-group={l.group} data-lead-title={l.t} class="card">
          <span class="group">{l.group}</span>
          <strong>{l.t}</strong>
          <span class="open">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm5.8 14.06c-.24.68-1.42 1.31-1.96 1.36-.54.05-1.05.24-3.53-.74-2.98-1.17-4.84-4.26-4.99-4.46-.14-.2-1.18-1.57-1.18-3 0-1.43.75-2.13 1.02-2.42.27-.29.58-.36.78-.36.2 0 .4.002.57.01.19.008.44-.07.68.52.24.59.83 2.03.9 2.18.07.15.12.32.02.51-.1.2-.15.32-.29.5-.15.17-.31.39-.44.52-.15.15-.3.31-.13.6.17.29.76 1.25 1.63 2.03 1.12 1 2.06 1.31 2.35 1.46.29.15.46.12.63-.07.17-.2.73-.85.93-1.14.2-.29.39-.24.66-.15.27.1 1.71.81 2 .95.29.15.49.22.56.34.07.13.07.73-.17 1.41Z"></path></svg>
            {t.leadCta}
          </span>
        </a>
      ))}
    </div>
    <p class="mail">{mailNote ?? t.leadMailNote} <a href={`mailto:${mail}`}>{mail}</a></p>
  </div>
</section>

<style>
  .cta {
    position: relative;
    background: var(--bg-dark);
    overflow: hidden;
  }
  .bg {
    background-position: 50% 70%;
    opacity: 0.8;
  }
  .inner {
    position: relative;
    padding-top: clamp(44px, 6vw, 80px);
    padding-bottom: clamp(44px, 6vw, 80px);
  }
  h2 {
    margin: 0 0 28px;
    max-width: 30ch;
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #fff;
    text-wrap: balance;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #fff;
  }
  .card:hover {
    border-color: var(--cyan);
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }
  .group {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #63ffa6;
  }
  strong {
    font-size: 16px;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }
  .open {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: auto;
    font-size: 12px;
    font-weight: 700;
    color: var(--cyan);
  }
  .mail {
    margin: 22px 0 0;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.7);
  }
  .mail a {
    color: #fff;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
  }
  .mail a:hover {
    color: var(--cyan);
  }
</style>
