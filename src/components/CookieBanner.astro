---
import { dictionaries, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const t = dictionaries[Astro.props.lang].cookie;
---
<div id="cookie-consent" hidden>
  <div class="inner">
    <p id="cookie-consent-text">{t.text}</p>
    <button id="cookie-consent-accept" type="button">{t.btn}</button>
  </div>
</div>

<script>
  import '../scripts/cookie-consent';
</script>

<style>
  #cookie-consent {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    background: var(--bg-dark);
    color: #fff;
    font-family: Montserrat, Arial, sans-serif;
    box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.25);
  }
  #cookie-consent[hidden] {
    display: none;
  }
  .inner {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 18px var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    justify-content: space-between;
  }
  p {
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--line-strong);
    flex: 1 1 320px;
  }
  button {
    flex: 0 0 auto;
    padding: 10px 22px;
    border: none;
    border-radius: var(--radius-pill);
    background: var(--blue);
    color: #fff;
    font-family: inherit;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
  }
</style>
