---
import { renderInline } from '../lib/inline';

interface Props {
  title: string;
  intro: string;
  stats: Array<{ v: string; k: string }>;
  readLabel: string;
  articleUrl: string;
  video: string;
  /** Video da entrevista no YouTube (miniatura clicavel). */
  videoId: string;
  videoAlt: string;
}
const { title, intro, stats, readLabel, articleUrl, video, videoId, videoAlt } = Astro.props;
---
<div class="rc">
  <div class="text">
    <h3>{title}</h3>
    <p class="intro" set:html={renderInline(intro)} />
    <div class="stats">
      {stats.map((s) => (
        <div class="stat">
          <span class="v">{s.v}</span>
          <span class="k">{s.k}</span>
        </div>
      ))}
    </div>
    <p class="links">
      <a href={articleUrl} target="_blank" rel="noopener" class="btn btn-grad" style="--btn-h: 42px; --btn-fs: 13px;">{readLabel}</a>
      <span class="video" set:html={renderInline(video)} />
    </p>
  </div>
  <a href={`https://www.youtube.com/watch?v=${videoId}`} target="_blank" rel="noopener" class="thumb">
    <img src={`https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`} alt={videoAlt} loading="lazy" width="1280" height="720" />
    <span class="badge" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="#fff"><path d="M8 5v14l11-7z"></path></svg>
    </span>
  </a>
</div>

<style>
  .rc {
    margin-top: 32px;
    padding: clamp(22px, 3vw, 32px);
    border-radius: var(--radius-lg);
    background: linear-gradient(120deg, var(--bg-dark) 0%, #071f72 62%, var(--blue) 100%);
    color: #fff;
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: start;
  }
  h3 {
    margin: 0 0 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #63ffa6;
  }
  .intro {
    margin: 0 0 22px;
    max-width: 72ch;
    font-size: 15px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.85);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 14px;
    margin-bottom: 22px;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }
  .v {
    font-size: clamp(26px, 3.2vw, 36px);
    font-weight: 800;
    letter-spacing: -0.03em;
    background: linear-gradient(90deg, var(--cyan-soft) 0%, #63ffa6 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .k {
    font-size: 13px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.8);
  }
  .links {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }
  .video {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.75);
  }
  .video :global(a) {
    color: var(--cyan-soft);
  }
  .thumb {
    position: relative;
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.16);
  }
  .thumb:hover {
    border-color: var(--cyan);
  }
  .thumb img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .badge {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 62px;
    height: 44px;
    border-radius: 11px;
    background: rgba(15, 20, 37, 0.82);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  @media (min-width: 960px) {
    .rc {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 32px;
    }
    .thumb {
      position: sticky;
      top: 90px;
    }
  }
</style>
