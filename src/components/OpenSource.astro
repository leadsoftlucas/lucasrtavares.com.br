---
import { dictionaries, type Lang } from '../i18n';
import { packages, packageCategoryOrder, nugetUrl, githubUrl, type PackageCategory } from '../data/packages';
import { links, ossStats } from '../data/links';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dictionaries[lang];
const num = (s: string) => Number(s.replace(/\./g, ''));
const cards = packages
  .map((p, i) => ({ ...p, desc: t.packageDescriptions[i], short: p.name.replace('LeadSoft.', '') }))
  .sort((a, b) => num(b.downloads) - num(a.downloads));
const chips = packageCategoryOrder.map((key) => ({
  key,
  label: t.packageCategories[key],
  count: key === 'all' ? cards.length : cards.filter((p) => p.category === key).length,
}));
const iconColors: Record<PackageCategory, { bg: string; stroke: string }> = {
  core: { bg: 'rgba(12,47,165,.10)', stroke: '#0C2FA5' },
  br: { bg: 'rgba(14,159,110,.12)', stroke: '#0E9F6E' },
  cloud: { bg: 'rgba(123,81,255,.12)', stroke: '#7B51FF' },
  sec: { bg: 'rgba(0,150,190,.12)', stroke: '#0096BE' },
};
---
<section id="codigo">
  <div class="wrap top">
    <p class="overline blue">{t.ossOverline}</p>
    <h2 class="h2">{t.ossTitle}</h2>
    <p class="lead">{t.ossLead}</p>
    <div class="stats">
      <div class="bg-cosmic"></div>
      <div class="stat">
        <p class="sv">{ossStats.downloads}</p>
        <p class="sk">{t.ossDownloads}</p>
      </div>
      <div class="stat">
        <p class="sv">{ossStats.packages}</p>
        <p class="sk">{t.ossPackages}</p>
      </div>
      <div class="stat">
        <p class="sv green">{ossStats.license}</p>
        <p class="sk">{t.ossLicense}</p>
      </div>
    </div>
  </div>
  <div class="wrap mid" data-package-filter>
    <div class="chips">
      {chips.map((c) => (
        <button type="button" class:list={['chip', { active: c.key === 'all' }]} data-filter={c.key} aria-pressed={c.key === 'all' ? 'true' : 'false'}>
          <span>{c.label}</span>
          <span class="count">{c.count}</span>
        </button>
      ))}
    </div>
    <div class="pkgs">
      {cards.map((p) => (
        <div class="pkg" data-category={p.category}>
          <div class="pkg-head">
            <span class="icon" style={`background: ${iconColors[p.category].bg};`}>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke={iconColors[p.category].stroke} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {p.category === 'core' && (<><path d="M12 3 3 7.5 12 12l9-4.5L12 3Z"></path><path d="M3 12l9 4.5L21 12"></path><path d="M3 16.5 12 21l9-4.5"></path></>)}
                {p.category === 'br' && (<><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></>)}
                {p.category === 'cloud' && <path d="M17.5 19a4.5 4.5 0 0 0 .5-8.97 6 6 0 0 0-11.66-1.4A4 4 0 0 0 6.5 19h11Z"></path>}
                {p.category === 'sec' && (<><path d="M12 3 5 6v5.5c0 4.3 2.9 8.2 7 9.5 4.1-1.3 7-5.2 7-9.5V6l-7-3Z"></path><path d="m9.5 12 1.8 1.8 3.4-3.4"></path></>)}
              </svg>
            </span>
            <div class="names">
              <p class="cat">{t.packageCategories[p.category]}</p>
              <p class="short">{p.short}</p>
            </div>
          </div>
          <p class="desc">{p.desc}</p>
          <div class="meta">
            <span class="dl">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"></path><path d="m7 11 5 5 5-5"></path><path d="M5 20h14"></path></svg>
              <span>{p.downloads}</span>
            </span>
            <span class="ver">v{p.version}</span>
          </div>
          <div class="actions">
            <a href={nugetUrl(p.name)} target="_blank" rel="noopener" class="a-nuget">NuGet</a>
            {p.repo && <a href={githubUrl(p.repo)} target="_blank" rel="noopener" class="a-gh">GitHub</a>}
          </div>
        </div>
      ))}
    </div>
  </div>
  <div class="wrap ctas">
    <a href={links.nugetProfile} target="_blank" rel="noopener" class="btn btn-grad" style="--btn-fs: 13px;">{t.ossCtaNuget}</a>
    <a href={links.githubOrgRepos} target="_blank" rel="noopener" class="btn gh-btn">{t.ossCtaGithub}</a>
  </div>
</section>

<script>
  import '../scripts/package-filter';
</script>

<style>
  section {
    background: linear-gradient(180deg, #eef2fc 0%, var(--bg-light) 55%, #edf1fb 100%);
    border-bottom: 1px solid #e1e6f2;
  }
  .top {
    padding-top: clamp(56px, 8vw, 96px);
    padding-bottom: clamp(28px, 4vw, 40px);
  }
  .blue {
    color: var(--blue-link);
  }
  .h2 {
    color: var(--ink);
  }
  .lead {
    margin: 0 0 30px;
    max-width: 64ch;
    color: var(--ink-soft);
  }
  .stats {
    position: relative;
    overflow: hidden;
    border-radius: 22px;
    background: linear-gradient(120deg, var(--bg-dark) 0%, #071f72 62%, var(--blue) 100%);
    padding: clamp(24px, 4vw, 34px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 24px;
  }
  .stats .bg-cosmic {
    background-position: 50% 40%;
    opacity: 0.55;
  }
  .stat {
    position: relative;
  }
  .sv {
    margin: 0;
    font-size: clamp(30px, 3.6vw, 42px);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .sv.green {
    color: #63ffa6;
  }
  .sk {
    margin: 6px 0 0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cyan-soft);
  }
  .mid {
    padding-bottom: clamp(40px, 6vw, 64px);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 24px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    padding: 0 16px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    font-family: inherit;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: all 0.15s ease;
    background: rgba(255, 255, 255, 0.7);
    color: var(--ink-soft);
    border: 1px solid var(--line-strong);
  }
  .chip.active {
    background: var(--ink);
    color: #fff;
    border-color: var(--ink);
  }
  .count {
    opacity: 0.62;
    font-variant-numeric: tabular-nums;
  }
  .pkgs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(272px, 1fr));
    gap: 16px;
  }
  .pkg {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 22px;
    border-radius: var(--radius-lg);
    background: #fff;
    border: 1px solid #e1e6f2;
    box-shadow: 0 2px 10px rgba(15, 20, 37, 0.05);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  .pkg[hidden] {
    display: none;
  }
  .pkg:hover {
    border-color: var(--blue-link);
    box-shadow: 0 18px 40px rgba(15, 20, 37, 0.12);
    transform: translateY(-2px);
  }
  .pkg-head {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .icon {
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .names {
    min-width: 0;
    flex: 1;
  }
  .cat {
    margin: 0;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #6c7075;
  }
  .short {
    margin: 3px 0 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink);
    overflow-wrap: anywhere;
    line-height: 1.35;
  }
  .desc {
    margin: 0;
    font-size: 13px;
    font-weight: 450;
    line-height: 1.55;
    color: var(--ink-soft);
    flex: 1;
    text-wrap: pretty;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .dl {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 11px;
    border-radius: var(--radius-pill);
    background: #eef2fc;
    color: var(--blue);
    font-size: 11px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .ver {
    padding: 5px 11px;
    border-radius: var(--radius-pill);
    background: #f4f4f6;
    color: var(--ink-soft);
    font-size: 11px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 2px;
    border-top: 1px solid #eef0f6;
  }
  .actions a {
    margin-top: 12px;
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .a-nuget,
  .a-nuget:hover {
    background: var(--ink);
    color: #fff;
  }
  .a-nuget:hover {
    background: var(--blue);
  }
  .a-gh {
    border: 1px solid var(--line-strong);
    color: var(--ink-soft);
  }
  .a-gh:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  .ctas {
    padding-bottom: clamp(48px, 7vw, 80px);
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .gh-btn {
    border: 1px solid var(--ink);
    color: var(--ink);
  }
  .gh-btn:hover {
    background: var(--ink);
    color: #fff;
  }
</style>
