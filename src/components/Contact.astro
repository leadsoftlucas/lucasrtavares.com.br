---
import { dictionaries, type Lang } from '../i18n';
import { config, whatsappLink } from '../config';
import { links } from '../data/links';

interface Props {
  lang: Lang;
}
const t = dictionaries[Astro.props.lang];
const waLink = whatsappLink(t.waMessage);
// 5541991821569 -> +55 41 99182-1569
const n = config.whatsappRavendb;
const waDisplay = `+${n.slice(0, 2)} ${n.slice(2, 4)} ${n.slice(4, 9)}-${n.slice(9)}`;
---
<section id="contato">
  <div class="bg-cosmic bg"></div>
  <div class="wrap inner">
    <h2>{t.contactTitle}</h2>
    <p class="lead">{t.contactLead}</p>
    <div class="grid">
      <a href={links.linkedin} target="_blank" rel="noopener" class="card in">
        <div class="who">
          <span class="avatar"><img src="/assets/avatar-head.webp" alt="" loading="lazy" /></span>
          <div class="wname">
            <p class="n">Lucas R. Tavares</p>
            <p class="r">{t.contactLinkedinRole}</p>
          </div>
          <img src="/assets/linkedin.png" alt="LinkedIn" width="30" height="30" class="li" loading="lazy" />
        </div>
        <p class="d">{t.contactLinkedin}</p>
        <span class="pill">{t.contactLinkedinCta}</span>
      </a>
      <a href={waLink} target="_blank" rel="noopener" class="card wa">
        <span class="w"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.5.11-.11.25-.29.37-.44.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.84-.2-.49-.4-.42-.55-.43h-.47c-.16 0-.43.06-.65.31-.22.25-.85.83-.85 2.03s.87 2.35.99 2.51c.12.16 1.71 2.61 4.15 3.66.58.25 1.03.4 1.39.51.58.19 1.11.16 1.53.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z"></path></svg></span>
        <h3>WhatsApp</h3>
        <p class="d">{t.contactWa}</p>
        <span class="num">{waDisplay}</span>
      </a>
      <div class="card">
        <img src="/assets/ravendb-r-mark.png" alt="RavenDB" width="42" height="42" class="rv" loading="lazy" />
        <h3>{t.contactMailTitle}</h3>
        <p class="d">{t.contactMail}</p>
        <a href={`mailto:${config.emailRavendb}`} class="mail">{config.emailRavendb}</a>
      </div>
    </div>
    <div class="follow">
      <div class="fl">
        <img src="/assets/ravendb-r-mark.png" alt="RavenDB" width="56" height="56" loading="lazy" />
        <div>
          <p class="overline green">{t.followOverline}</p>
          <p class="ft">{t.followTitle}</p>
        </div>
      </div>
      <div class="fbtns">
        <a href={links.ravendb} target="_blank" rel="noopener" class="btn btn-grad" style="--btn-h: 48px; --btn-fs: 14px;">{t.followSite}</a>
        <a href={links.ravendbLinkedin} target="_blank" rel="noopener" class="btn btn-line-light" style="--btn-h: 48px; --btn-fs: 14px; font-weight: 700; border-color: rgba(255,255,255,.34);">
          <img src="/assets/linkedin.png" alt="" width="22" height="22" class="fli" loading="lazy" />
          <span>{t.followLinkedin}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    background: var(--bg-dark);
    position: relative;
    overflow: hidden;
  }
  .bg {
    background-position: 50% 70%;
    opacity: 0.9;
  }
  .inner {
    position: relative;
    padding-top: clamp(56px, 8vw, 104px);
    padding-bottom: clamp(56px, 8vw, 104px);
  }
  h2 {
    margin: 0 0 12px;
    font-size: clamp(28px, 3.6vw, 42px);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #fff;
    text-wrap: balance;
  }
  .lead {
    margin: 0 0 40px;
    max-width: 58ch;
    color: rgba(255, 255, 255, 0.75);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: inherit;
  }
  a.card:hover {
    background: rgba(255, 255, 255, 0.1);
    color: inherit;
  }
  a.in:hover {
    border-color: var(--cyan);
  }
  a.wa:hover {
    border-color: #63ffa6;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .avatar {
    position: relative;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    overflow: hidden;
    flex: 0 0 auto;
    background: linear-gradient(160deg, var(--blue-link) 0%, #071f72 100%);
    border: 2px solid rgba(28, 200, 238, 0.5);
  }
  .avatar img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .wname {
    min-width: 0;
  }
  .n {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .r {
    margin: 2px 0 0;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
  }
  .li {
    width: 30px;
    height: 30px;
    display: block;
    border-radius: 8px;
    margin-left: auto;
  }
  .d {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.68);
  }
  .pill {
    align-self: flex-start;
    padding: 8px 18px;
    border-radius: var(--radius-pill);
    background: var(--cyan);
    color: #06121f;
    font-size: 13px;
    font-weight: 700;
  }
  .w {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--blue-link) 0%, var(--cyan) 100%);
    color: #06121f;
  }
  h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .num {
    font-size: 13px;
    font-weight: 600;
    color: var(--cyan);
  }
  .rv {
    width: 42px;
    height: 42px;
    object-fit: contain;
    display: block;
  }
  .mail {
    font-size: 13px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
    border-bottom: 1px solid rgba(255, 255, 255, 0.22);
    align-self: flex-start;
  }
  .mail:hover {
    color: var(--cyan);
  }
  .follow {
    margin-top: 22px;
    padding: clamp(24px, 4vw, 34px);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.055);
    border: 1px solid rgba(28, 200, 238, 0.3);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
    align-items: center;
  }
  .fl {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .fl img {
    width: 56px;
    height: 56px;
    object-fit: contain;
    display: block;
  }
  .overline {
    margin: 0 0 6px;
  }
  .green {
    color: #63ffa6;
  }
  .ft {
    margin: 0;
    font-size: clamp(19px, 2.4vw, 24px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
    text-wrap: balance;
  }
  .fbtns {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: flex-start;
  }
  .fli {
    border-radius: 5px;
    display: block;
  }
</style>
