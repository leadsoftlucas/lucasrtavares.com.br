---
import { type Lang } from '../i18n';
import Hero from './Hero.astro';
import LeadCards from './LeadCards.astro';
import Metrics from './Metrics.astro';
import About from './About.astro';
import StoryTeaser from './StoryTeaser.astro';
import Services from './Services.astro';
import Timeline from './Timeline.astro';
import LeadsoftBand from './LeadsoftBand.astro';
import OpenSource from './OpenSource.astro';
import Events from './Events.astro';
import Videos from './Videos.astro';
import Articles from './Articles.astro';
import Community from './Community.astro';
import Contact from './Contact.astro';
import WhatsAppFab from './WhatsAppFab.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---
<Hero lang={lang} />
<LeadCards lang={lang} />
<Metrics lang={lang} />
<About lang={lang} />
<StoryTeaser lang={lang} />
<Services lang={lang} />
<Timeline lang={lang} />
<LeadsoftBand lang={lang} />
<OpenSource lang={lang} />
<Events lang={lang} />
<Videos lang={lang} />
<Articles lang={lang} />
<Community lang={lang} />
<Contact lang={lang} />
<WhatsAppFab lang={lang} />

<script>
  import '../scripts/reveal';
</script>
