---
import { dictionaries, type Lang } from '../i18n';
import { whatsappLink } from '../config';
import { links } from '../data/links';

interface Props {
  lang: Lang;
}
const t = dictionaries[Astro.props.lang];
const inviteLink = whatsappLink(t.leads[5]?.msg ?? '');
---
<section>
  <div class="bg-cosmic bg"></div>
  <div class="wrap inner">
    <div>
      <p class="overline green">{t.communityOverline}</p>
      <h2>{t.communityTitle}</h2>
      <p class="body">{t.communityBody}</p>
    </div>
    <div class="ctas">
      <a href={inviteLink} target="_blank" rel="noopener" class="btn btn-grad">{t.communityCta}</a>
      <a href={links.linkedin} target="_blank" rel="noopener" class="btn btn-line-light">{t.communityCta2}</a>
    </div>
  </div>
</section>

<style>
  section {
    background: var(--bg-dark);
    position: relative;
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .bg {
    background-position: 50% 70%;
    opacity: 0.5;
  }
  .inner {
    position: relative;
    padding-top: clamp(40px, 5vw, 60px);
    padding-bottom: clamp(40px, 5vw, 60px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 28px;
    align-items: center;
  }
  .overline {
    margin-bottom: 10px;
  }
  .green {
    color: #63ffa6;
  }
  h2 {
    margin: 0 0 12px;
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.18;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #fff;
    text-wrap: balance;
  }
  .body {
    margin: 0;
    max-width: 56ch;
    font-size: 15px;
    line-height: 1.68;
    color: rgba(255, 255, 255, 0.72);
    text-wrap: pretty;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
