{
  "ci": {
    "collect": {
      "startServerCommand": "npx astro preview --port 4173",
      "startServerReadyPattern": "Local",
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/en/",
        "http://localhost:4173/historia/",
        "http://localhost:4173/en/history/",
        "http://localhost:4173/provas/",
        "http://localhost:4173/en/proof/",
        "http://localhost:4173/imprensa/",
        "http://localhost:4173/en/press/"
      ],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.98 }],
        "categories:best-practices": ["error", { "minScore": 0.98 }],
        "categories:seo": ["error", { "minScore": 0.98 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
